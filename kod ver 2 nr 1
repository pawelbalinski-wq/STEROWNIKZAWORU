### Przyjęte piny Arduino Uno

| Sygnał | Pin |
|---|---:|
| `sZMP` | D10 |
| `sZML` | D11 |
| `pompaPod` | D12 |
| `pompaKal` | A0 |
| `wPracyKotla` | A1 |
| `TERM1` | D9 |
| `buzzer` | A2 |
| `Przycisk_1` | D3 |
| `Przycisk_2` | D4 |
| `Przycisk_3` | D5 |
| `Przycisk_4` | D6 |
| `Przycisk_5` | D7 |
| DS18B20 | D8 |
| DS3231 / LCD | I2C: A4/A5 |
| SQW DS3231 | D2 |

Wszystkie trzy czujniki temperatury mogą mieć osobne adresy DS18B20 na jednej magistrali D8.

```cpp
#include <Arduino.h>
#include <Wire.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <LiquidCrystal_I2C.h>
#include <RTClib.h>
#include <EEPROM.h>

// ====================== PINY ======================
#define PIN_ONEWIRE     8
#define PIN_TERM1       9
#define PIN_SZMP        10
#define PIN_SZML        11
#define PIN_POMPA_POD   12
#define PIN_POMPA_KAL   A0
#define PIN_KOTEL       A1
#define PIN_BUZZER      A2

#define PIN_KLAWISZ_1   3
#define PIN_KLAWISZ_2   4
#define PIN_KLAWISZ_3   5
#define PIN_KLAWISZ_4   6
#define PIN_KLAWISZ_5   7
#define PIN_SQW         2

// ====================== CZUJKI ======================
#define ADR_CTZ  0
#define ADR_CTZM 1
#define ADR_CTWM 2
#define ADR_CTPP 3

// ====================== STAŁE ======================
enum Tryb {
  TRYB_LATO,
  TRYB_WIOSNA,
  TRYB_ZIMA
};

enum ElementEdycji {
  EDYCJA_TWM1,
  EDYCJA_TWM2,
  EDYCJA_TWM3,
  EDYCJA_TWM4,
  EDYCJA_TOBN
};

const uint8_t BLOKADY_ROZRUCHU_MS = 50;
const unsigned long CZAS_RUCHU_MIESZACZA = 120000UL;
const unsigned long CZAS_LCD = 500;
const unsigned long CZAS_TERMOSTAT = 1000;
const unsigned long CZAS_CZUJNIKOW = 1000;

// ====================== OBIEKTY ======================
OneWire oneWire(PIN_ONEWIRE);
DallasTemperature sensors(&oneWire);
LiquidCrystal_I2C lcd(0x27, 16, 2);
RTC_DS3231 rtc;

DeviceAddress czujnik[4];

// ====================== ZMIENNE ======================
Tryb tryb = TRYB_LATO;
ElementEdycji edycja = EDYCJA_TWM1;

float btZ = 0;
float tzM = 0;
float tWM = 0;
float tPP = 0;

float tWM1 = 40;
float tWM2 = 34;
float tWM3 = 30;
float tWM4 = 28;
float tOBN = 3;

float zadanaTWM = 28;
float pidPoprzedniBlad = 0;
float pidSuma = 0;

bool stopAktywny = false;
bool antystopAktywny = false;
bool antystopUruchomiony = false;
bool zaworSZML = false;
bool zaworSZMP = false;
bool alarmAktywny = false;

unsigned long czasLCD = 0;
unsigned long czasCzujnikow = 0;
unsigned long czasSZW = 0;
unsigned long czasStopniowania = 0;
unsigned long czasAlarmu = 0;
unsigned long czasAntystopu = 0;

byte czujnikiOK = 0;
byte indeksAntystopu = 0;

// ====================== EEPROM ======================
struct ParametryEEPROM {
  uint16_t magic;
  float wm1;
  float wm2;
  float wm3;
  float wm4;
  float obn;
};

const uint16_t MAGIC = 0xA5C3;

void zapisEEPROM() {
  ParametryEEPROM p;
  p.magic = MAGIC;
  p.wm1 = tWM1;
  p.wm2 = tWM2;
  p.wm3 = tWM3;
  p.wm4 = tWM4;
  p.obn = tOBN;

  EEPROM.put(0, p);
}

void odczytEEPROM() {
  ParametryEEPROM p;
  EEPROM.get(0, p);

  if (p.magic != MAGIC) {
    zapisEEPROM();
    return;
  }

  tWM1 = constrain(p.wm1, 20, 49);
  tWM2 = constrain(p.wm2, 20, 49);
  tWM3 = constrain(p.wm3, 20, 49);
  tWM4 = constrain(p.wm4, 20, 49);
  tOBN = constrain(p.obn, 0, 9);
}

// ====================== PRZYCISKI ======================
bool stanPrzycisku(byte pin) {
  return digitalRead(pin) == LOW;
}

bool zboczeOpadania(byte pin) {
  static bool poprzedni[8];
  bool aktualny = stanPrzycisku(pin);
  bool wynik = poprzedni[pin] && !aktualny;
  poprzedni[pin] = aktualny;
  return wynik;
}

void odczytajPrzyciski() {
  if (zboczeOpadania(PIN_KLAWISZ_1)) {
    if (edycja == EDYCJA_TWM1) tWM1++;
    if (edycja == EDYCJA_TWM2) tWM2++;
    if (edycja == EDYCJA_TWM3) tWM3++;
    if (edycja == EDYCJA_TWM4) tWM4++;
    if (edycja == EDYCJA_TOBN) tOBN++;
    zapisEEPROM();
  }

  if (zboczeOpadania(PIN_KLAWISZ_2)) {
    if (edycja == EDYCJA_TWM1) tWM1--;
    if (edycja == EDYCJA_TWM2) tWM2--;
    if (edycja == EDYCJA_TWM3) tWM3--;
    if (edycja == EDYCJA_TWM4) tWM4--;
    if (edycja == EDYCJA_TOBN) tOBN--;
    zapisEEPROM();
  }

  if (zboczeOpadania(PIN_KLAWISZ_3)) {
    edycja = static_cast<ElementEdycji>((edycja + 1) % 5);
  }

  if (zboczeOpadania(PIN_KLAWISZ_4)) {
    if (tryb == TRYB_LATO) tryb = TRYB_WIOSNA;
    else if (tryb == TRYB_WIOSNA) tryb = TRYB_ZIMA;
    else tryb = TRYB_LATO;

    ustawTryb();
  }

  if (zboczeOpadania(PIN_KLAWISZ_5)) {
    stopAktywny = !stopAktywny;

    if (stopAktywny)
      funkcjaStop();
  }
}

// ====================== CZUJNIKI ======================
void znajdzCzujniki() {
  sensors.begin();

  if (sensors.getDeviceCount() < 4) {
    czujnikiOK = 0;
    return;
  }

  for (uint8_t i = 0; i < 4; i++) {
    if (!sensors.getAddress(czujnik[i], i)) {
      czujnikiOK = 0;
      return;
    }
  }

  czujnikiOK = 1;
  sensors.setResolution(12);
  sensors.setWaitForConversion(false);
}

void odczytajCzujniki() {
  sensors.requestTemperatures();

  if (!czujnikiOK) return;

  float bZ = sensors.getTempC(czujnik[ADR_CTZ]);
  float bZM = sensors.getTempC(czujnik[ADR_CTZM]);
  float bWM = sensors.getTempC(czujnik[ADR_CTWM]);
  float bPP = sensors.getTempC(czujnik[ADR_CTPP]);

  if (bZ == DEVICE_DISCONNECTED_C ||
      bZM == DEVICE_DISCONNECTED_C ||
      bWM == DEVICE_DISCONNECTED_C ||
      bPP == DEVICE_DISCONNECTED_C) {
    czujnikiOK = 0;
    digitalWrite(PIN_BUZZER, HIGH);
    return;
  }

  btZ = bZ;
  tzM = bZM;
  tWM = bWM;
  tPP = bPP;
  czujnikiOK = 1;
}

// ====================== KRZYWA GRZEWCZA ======================
float interpolate(float x1, float y1, float x2, float y2, float x) {
  if (x2 == x1) return y1;
  return y1 + (x - x1) * (y2 - y1) / (x2 - x1);
}

float obliczZadanaTWM() {
  if (btZ <= -20) return tWM1;
  if (btZ >= 10) return tWM4;

  if (btZ < -10)
    return interpolate(-20, tWM1, -10, tWM2, btZ);

  if (btZ < 0)
    return interpolate(-10, tWM2, 0, tWM3, btZ);

  return interpolate(0, tWM3, 10, tWM4, btZ);
}

// ====================== ZAWÓR ======================
void zatrzymajZawor() {
  zaworSZML = false;
  zaworSZMP = false;
  digitalWrite(PIN_SZML, LOW);
  digitalWrite(PIN_SZMP, LOW);
}

void startSZML() {
  if (zaworSZMP) zatrzymajZawor();
  digitalWrite(PIN_SZML, HIGH);
  zaworSZML = true;
  zaworSZMP = false;
  czasSZW = millis();
}

void startSZMP() {
  if (zaworSZML) zatrzymajZawor();
  digitalWrite(PIN_SZMP, HIGH);
  zaworSZMP = true;
  zaworSZML = false;
  czasSZW = millis();
}

void regulatorZaworu() {
  if (tryb != TRYB_ZIMA || stopAktywny) {
    zatrzymajZawor();
    return;
  }

  zadanaTWM = obliczZadanaTWM();

  if (digitalRead(PIN_TERM1) == LOW) {
    zadanaTWM -= tOBN;
  }

  float blad = zadanaTWM - tWM;

  pidSuma += blad;
  pidSuma = constrain(pidSuma, -20, 20);

  float rozniczka = blad - pidPoprzedniBlad;
  pidPoprzedniBlad = blad;

  float sterowanie = 1.2 * blad + 0.02 * pidSuma + 0.8 * rozniczka;

  if (fabs(sterowanie) < 0.7) {
    if (zaworSZML || zaworSZMP) {
      if (millis() - czasStopniowania > 3000)
        zatrzymajZawor();
    }
    return;
  }

  if (sterowanie > 0) {
    startSZMP();
  } else {
    startSZML();
  }

  czasStopniowania = millis();

  if (millis() - czasSZW >= CZAS_RUCHU_MIESZACZA) {
    zatrzymajZawor();
  }
}

// ====================== TRYBY ======================
void funkcjaStop() {
  zatrzymajZawor();
  digitalWrite(PIN_POMPA_POD, LOW);
  digitalWrite(PIN_POMPA_KAL, LOW);
  digitalWrite(PIN_KOTEL, LOW);
}

void ustawTryb() {
  zatrzymajZawor();

  if (stopAktywny) {
    funkcjaStop();
    return;
  }

  if (tryb == TRYB_LATO) {
    digitalWrite(PIN_KOTEL, LOW);
    digitalWrite(PIN_POMPA_POD, LOW);
    digitalWrite(PIN_POMPA_KAL, LOW);

    startSZML();
    antystopAktywny = true;
  }

  if (tryb == TRYB_ZIMA) {
    digitalWrite(PIN_KOTEL, HIGH);
    digitalWrite(PIN_POMPA_POD, HIGH);
    digitalWrite(PIN_POMPA_KAL, HIGH);
    antystopAktywny = false;
  }

  if (tryb == TRYB_WIOSNA) {
    digitalWrite(PIN_KOTEL, HIGH);
    digitalWrite(PIN_POMPA_POD, LOW);
    digitalWrite(PIN_POMPA_KAL, HIGH);

    startSZML();
    antystopAktywny = false;
  }
}

// ====================== ANTYSTOP ======================
void uruchomAntystop() {
  antystopUruchomiony = true;
  antystopAktywny = false;
  indeksAntystopu = 0;
  czasAntystopu = millis();
}

void procesAntystop() {
  if (!antystopUruchomiony) return;

  unsigned long uplynelo = millis() - czasAntystopu;

  if (indeksAntystopu == 0) {
    digitalWrite(PIN_POMPA_POD, HIGH);
    digitalWrite(PIN_KOTEL, HIGH);

    if (uplynelo >= 60000UL) {
      indeksAntystopu = 1;
      czasAntystopu = millis();
    }
  }

  if (indeksAntystopu == 1) {
    digitalWrite(PIN_POMPA_POD, HIGH);

    if (uplynelo >= 120000UL) {
      digitalWrite(PIN_POMPA_POD, LOW);
      indeksAntystopu = 2;
      czasAntystopu = millis();
    }
  }

  if (indeksAntystopu == 2) {
    if (uplynelo >= 2000UL) {
      indeksAntystopu = 3;
      czasAntystopu = millis();
    }
  }

  if (indeksAntystopu == 3) {
    digitalWrite(PIN_POMPA_KAL, HIGH);

    if (uplynelo >= 120000UL) {
      digitalWrite(PIN_POMPA_KAL, LOW);
      digitalWrite(PIN_POMPA_POD, LOW);
      digitalWrite(PIN_KOTEL, LOW);

      antystopUruchomiony = false;
      indeksAntystopu = 0;
    }
  }
}

// ====================== ZABEZPIECZENIA ======================
void sprawdzBezpieczenstwo() {
  if (!czujnikiOK) {
    digitalWrite(PIN_BUZZER, HIGH);
    zatrzymajZawor();
    funkcjaStop();
    return;
  }

  if (tWM > 49.0) {
    if (!alarmAktywny) {
      alarmAktywny = true;
      czasAlarmu = millis();
    }

    zatrzymajZawor();
    startSZML();

    digitalWrite(PIN_POMPA_POD, LOW);
    digitalWrite(PIN_POMPA_KAL, LOW);
    digitalWrite(PIN_BUZZER, HIGH);

    if (millis() - czasAlarmu >= 1200000UL) {
      void(*resetuj)(void) = 0;
      resetuj();
    }
  } else {
    alarmAktywny = false;
  }
}

// ====================== LCD ======================
void wyswietlLCD() {
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print((int)tWM1);
  lcd.print(" ");
  lcd.print((int)tWM2);
  lcd.print(" ");
  lcd.print((int)tWM3);
  lcd.print(" ");
  lcd.print((int)tWM4);

  lcd.setCursor(15, 0);

  if (zaworSZML)
    lcd.print("<");
  else if (zaworSZMP)
    lcd.print(">");
  else
    lcd.print("0");

  lcd.setCursor(0, 1);
  lcd.print("Z");

  if (btZ >= 0) lcd.print("+");
  lcd.print((int)btZ);

  lcd.setCursor(5, 1);
  lcd.print((int)tOBN);

  lcd.setCursor(7, 1);
  lcd.print((int)tWM);

  lcd.setCursor(12, 1);

  int roznica = abs((int)(tWM - tPP));
  lcd.print(roznica);

  if (tWM - tPP > 7)
    lcd.print(">");
  else if (tWM - tPP < 5)
    lcd.print("<");
}

// ====================== SETUP ======================
void setup() {
  pinMode(PIN_TERM1, INPUT_PULLUP);
  pinMode(PIN_SQW, INPUT);

  pinMode(PIN_SZMP, OUTPUT);
  pinMode(PIN_SZML, OUTPUT);
  pinMode(PIN_POMPA_POD, OUTPUT);
  pinMode(PIN_POMPA_KAL, OUTPUT);
  pinMode(PIN_KOTEL, OUTPUT);
  pinMode(PIN_BUZZER, OUTPUT);

  pinMode(PIN_KLAWISZ_1, INPUT_PULLUP);
  pinMode(PIN_KLAWISZ_2, INPUT_PULLUP);
  pinMode(PIN_KLAWISZ_3, INPUT_PULLUP);
  pinMode(PIN_KLAWISZ_4, INPUT_PULLUP);
  pinMode(PIN_KLAWISZ_5, INPUT_PULLUP);

  zatrzymajZawor();
  digitalWrite(PIN_POMPA_POD, LOW);
  digitalWrite(PIN_POMPA_KAL, LOW);
  digitalWrite(PIN_KOTEL, LOW);
  digitalWrite(PIN_BUZZER, LOW);

  Wire.begin();

  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.print("Uruchamianie");

  if (!rtc.begin()) {
    digitalWrite(PIN_BUZZER, HIGH);
  }

  odczytEEPROM();
  znajdzCzujniki();

  tryb = TRYB_LATO;
  ustawTryb();
}

// ====================== LOOP ======================
void loop() {
  unsigned long teraz = millis();

  odczytajPrzyciski();

  if (teraz - czasCzujnikow >= CZAS_CZUJNIKOW) {
    czasCzujnikow = teraz;

    odczytajCzujniki();
    sprawdzBezpieczenstwo();
  }

  if (tryb == TRYB_ZIMA && !stopAktywny) {
    regulatorZaworu();
  }

  if (zaworSZML || zaworSZMP) {
    if (teraz - czasSZW >= CZAS_RUCHU_MIESZACZA) {
      zatrzymajZawor();
    }
  }

  procesAntystop();

  if (teraz - czasLCD >= CZAS_LCD) {
    czasLCD = teraz;
    wyswietlLCD();
  }
}
